{
  "name": "mondiro-payline-generator",
  "productName": "Mondiro Payline Generator",
  "version": "2.0.0",
  "description": "Standalone tool to generate slot-game payline curve animations and export to Spine 3.7.94 JSON",
  "main": "main.js",
  "author": "Mondiro",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mondiro.paylinegenerator",
    "productName": "Mondiro Payline Generator",
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Mondiro-Payline-Generator-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true
    }
  }
}
