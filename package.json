{
  "name": "mondiro-payline-generator",
  "productName": "Mondiro Payline Generator",
  "version": "2.0.3",
  "description": "Standalone tool to generate slot-game payline curve animations and export to Spine 3.7.94 JSON",
  "main": "main.js",
  "author": "Mondiro",
  "scripts": {
    "start": "electron .",
    "dist": "set CSC_IDENTITY_AUTO_DISCOVERY=false&&electron-builder --win nsis --x64",
    "dist:folder": "set CSC_IDENTITY_AUTO_DISCOVERY=false&&electron-builder --win --x64 --dir"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mondiro.paylinegenerator",
    "productName": "Mondiro Payline Generator",
    "copyright": "Powered by Mondiro",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "license.js",
      "updater.js",
      "renderer/**",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "!dist/**",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Mondiro-Payline-Generator-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mondiro Payline Generator"
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "satthupc00",
        "repo": "Payline-Generator",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
